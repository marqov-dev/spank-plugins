{
  "_comment": [
    "Credentials here are consumed by the SPANK plugin at job prolog time (runs as root/slurm).",
    "IBM API keys are exchanged for short-lived (1hr) bearer tokens before the job starts.",
    "Raw credentials are NEVER injected into the job environment.",
    "PROTECT THIS FILE: chmod 640 /etc/slurm/qrmi_config.json && chown root:slurm /etc/slurm/qrmi_config.json"
  ],
  "resources": [
    {
      "name": "test_heron",
      "type": "ibm-quantum-system",
      "environment": {
        "QRMI_IBM_QS_ENDPOINT":              "https://your-qs-endpoint.example.com",
        "QRMI_IBM_QS_IAM_ENDPOINT":          "https://iam.cloud.ibm.com",
        "QRMI_IBM_QS_IAM_APIKEY":            "<IBM CLOUD API KEY — exchanged for 1hr token at job start>",
        "QRMI_IBM_QS_SERVICE_CRN":           "<SERVICE CRN>",
        "QRMI_IBM_QS_AWS_ACCESS_KEY_ID":     "<S3 HMAC ACCESS KEY>",
        "QRMI_IBM_QS_AWS_SECRET_ACCESS_KEY": "<S3 HMAC SECRET>",
        "QRMI_IBM_QS_S3_ENDPOINT":           "https://s3.us-east.cloud-object-storage.appdomain.cloud",
        "QRMI_IBM_QS_S3_BUCKET":             "<BUCKET NAME>",
        "QRMI_IBM_QS_S3_REGION":             "us-east"
      }
    },
    {
      "name": "FRESNEL",
      "type": "pasqal-cloud",
      "environment": {
        "QRMI_PASQAL_CLOUD_PROJECT_ID":  "<PROJECT ID>",
        "QRMI_PASQAL_CLOUD_AUTH_TOKEN":  "<AUTH TOKEN>"
      }
    }
  ]
}
